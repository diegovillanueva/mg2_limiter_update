! user_nl_cam for run DustOnly-NieSing-1979 (mg2_limiter_update; CESM 2.1.5 F2000climo f09_g17).

! SPPE block: dust immersion freezing is the only heterogeneous mixed-phase ice source.
hclas_du_imm = 1
hclas_du_dep = 0.0
hclas_du_cnt = 0.0
hclas_bc_imm = 0.0
hclas_bc_dep = 0.0
hclas_bc_cnt = 0.0
riming_factor = 1
auto_liq_factor = 1
micro_mg_ice_berg_ice_factor = 1
micro_mg_ice_berg_snow_factor = 1
factor_HM = 0
onoff_sip = .false.
onoff_contact_freezing = .false.
rain_freeze = .false.
depr_point_frz = .false.
naai_het_also_in_mpc = .false.
detrainment_ramp_liq = .true.
micro_mg_num_steps = 8
! NieSing-1979: as DustOnly-NieSing, started 1979-01-01 (Fig. 3 long run).
! No ice-number cap, singular Niemand et al. (2012) dust immersion freezing; limfacdu is not used when a Niemand switch is set.
enable_nimax = .false.
limfacdu = 0.05
limfacdu_niemand_singular = .true.
limfacdu_niemand_factor = 1.0
limfacdu_niemand_max = 100.0

! Nudging: ERA5 U/V only, 6-hourly files, linear interpolation, weak time scale, global, full column.
! NUDGING_DIR is replaced by scripts/create_case.sh with the directory of your ERA5 nudging files.
Nudge_Model    = .true.
Nudge_Path     = 'NUDGING_DIR/'
Nudge_File_Template = 'ERA5_x_fv1x1_L32_rgC2_WO.%y-%m-%d-%s.nc'

Nudge_Times_Per_Day = 4

! Wind nudging on; relaxation coefficient 1 with the weak time-scale option (0).
Nudge_Uprof  = 1
Nudge_Ucoef  = 1
Nudge_Vprof  = 1
Nudge_Vcoef  = 1

! T, Q and PS nudging off
Nudge_Tprof  = 0
Nudge_Tcoef  = 0.0
Nudge_Qprof  = 0
Nudge_Qcoef  = 0.0
Nudge_PSprof = 0
Nudge_PScoef = 0.0

! Nudging period
Nudge_Beg_Year  = 1979
Nudge_Beg_Month = 1
Nudge_Beg_Day   = 1
Nudge_End_Year  = 2024
Nudge_End_Month = 12
Nudge_End_Day   = 31

! Global, full-column nudging window
Nudge_Hwin_lat0     = 0.0
Nudge_Hwin_latWidth = 999.0
Nudge_Hwin_latDelta = 0.1
Nudge_Hwin_lon0     = 180.0
Nudge_Hwin_lonWidth = 999.0
Nudge_Hwin_lonDelta = 0.1
Nudge_Vwin_Lindex   = 0.0
Nudge_Vwin_Ldelta   = 0.001
Nudge_Vwin_Hindex   = 33.0
Nudge_Vwin_Hdelta   = 0.001

! Linear interpolation in time between nudging files.
Nudge_Force_Opt = 1
! Weak time-scale option (0).
Nudge_TimeScale_Opt  = 0
! Nudging tendency updated every model time step (CAM dt = 1800 s).
Model_Times_Per_Day  = 48

! History output: h0 monthly only.
! The cloud-top diagnostics of Fig. 3 of Villanueva et al. (in review) are not requested here;
! see the README section "Long runs (Fig. 3)".
nhtfrq = 0
mfilt  = 1

fincl1 = 'CLD_CAL_TMPICE:A','CLD_CAL_TMPLIQ:A','CLD_CAL_TMPUN:A','CLD_CAL_TMP:A',
         'AODVIS:A','AODDUST:A','AODSO4:A','AODBC:A','AODPOM:A','AODSOA:A','AODSS:A',
