! 🧊📦 user_nl_cam for run DustOnly-Cap (mg2_limiter_update; CESM 2.1.5 F2000climo f09_g17).

! 🧪🧊 SPPE block: dust immersion freezing is the only heterogeneous mixed-phase ice source.
hclas_du_imm = 1
hclas_du_dep = 0.0
hclas_du_cnt = 0.0
hclas_bc_imm = 0.0
hclas_bc_dep = 0.0
hclas_bc_cnt = 0.0
riming_factor = 1
auto_liq_factor = 1
micro_mg_ice_berg_ice_factor = 1
micro_mg_ice_berg_snow_factor = 1
factor_HM = 0
onoff_sip = .false.
onoff_contact_freezing = .false.
rain_freeze = .false.
depr_point_frz = .false.
naai_het_also_in_mpc = .false.
detrainment_ramp_liq = .true.
micro_mg_num_steps = 8
! 🧊🧢 Cap: ice-number cap kept on (enable_nimax and limfacdu at their defaults).

! 🌬️🧭 Nudging: ERA5 U/V only, 6-hourly files, linear interpolation, weak time scale, global, full column.
! 📂🔧 NUDGING_DIR is replaced by scripts/create_case.sh with the directory of your ERA5 nudging files.
Nudge_Model    = .true.
Nudge_Path     = 'NUDGING_DIR/'
Nudge_File_Template = 'ERA5_x_fv1x1_L32_rgC2_WO.%y-%m-%d-%s.nc'

Nudge_Times_Per_Day = 4

! Wind nudging ON (reduced strength to avoid aerosol instability)
Nudge_Uprof  = 1
Nudge_Ucoef  = 1 ! weak nudging, otherwise crash!
Nudge_Vprof  = 1
Nudge_Vcoef  = 1

! T, Q, PS nudging OFF
Nudge_Tprof  = 0
Nudge_Tcoef  = 0.0
Nudge_Qprof  = 0
Nudge_Qcoef  = 0.0
Nudge_PSprof = 0
Nudge_PScoef = 0.0

! Date range
Nudge_Beg_Year  = 2000
Nudge_Beg_Month = 1
Nudge_Beg_Day   = 1
Nudge_End_Year  = 2025
Nudge_End_Month = 12
Nudge_End_Day   = 31

! Nudge globally, entire column
Nudge_Hwin_lat0     = 0.0
Nudge_Hwin_latWidth = 999.0
Nudge_Hwin_latDelta = 0.1
Nudge_Hwin_lon0     = 180.0
Nudge_Hwin_lonWidth = 999.0
Nudge_Hwin_lonDelta = 0.1
Nudge_Vwin_Lindex   = 0.0
Nudge_Vwin_Ldelta   = 0.001
Nudge_Vwin_Hindex   = 33.0
Nudge_Vwin_Hdelta   = 0.001

! for stability
! smoother and more stable than stepping to next file
Nudge_Force_Opt = 1 ! LINEAR
! safer than STRONG, especially if stronger settings already crash
Nudge_TimeScale_Opt  = 0      ! WEAK
! update nudging every model step if CAM dt = 1800 s = 30 min
Model_Times_Per_Day  = 48

! 📤📊 History output: h0 monthly, h1 daily 3-D mass, h2 daily 2-D paths, h3 daily COSP, h4 hourly precipitation.
nhtfrq   = 0, -24, -24 , -24, -1
mfilt    = 1,   1,    1 , 1,  48

