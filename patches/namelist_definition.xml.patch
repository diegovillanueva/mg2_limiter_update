 Default: none
 </entry>
 
+<!-- 🧊🔧 micro_dv_nl: dust-ice limiter and sensitivity controls of the letter runs -->
+
+<entry id="enable_nimax" type="logical" category="conv"
+       group="micro_dv_nl" valid_values="" >
+Switch nimax threshold (should be disabled)
+Default: .true.
+</entry>
+
+<entry id="naai_het_also_in_mpc" type="logical" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+controls naai (deposition) nucleation in mpc clouds
+Default: true
+</entry>
+
+<entry id="limfacdu" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+limit dust aerosol N for ice nucleation
+Default: 5%
+</entry>
+
+<entry id="limfacdu_niemand_singular" type="logical" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+If .true., dust immersion freezing uses Niemand et al. (2012) as a standalone
+singular (time-independent) scheme instead of CNT/PDF: the number of immersed dust
+particles active at T, sum over modes of MIN(factor*FF(T,r), max/100)*N_dust,
+minus the in-cloud ice number already present, is frozen within one step
+(ECHAM-HAM approach). Uses limfacdu_niemand_factor/max; set
+limfacdu_niemand_max=100 for an uncapped FF.
+BC immersion and dust contact/deposition freezing stay CNT.
+Default: .false.
+</entry>
+
+<entry id="limfacdu_niemand_continuous" type="logical" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+If .true., dust immersion freezing uses Niemand et al. (2012) as a standalone
+continuous scheme: every step, sum over modes of MIN(factor*FF(T,r), max/100)*N_dust
+is frozen, without subtracting the in-cloud ice number already present (unlike
+limfacdu_niemand_singular). Takes precedence over limfacdu_niemand_singular.
+Uses limfacdu_niemand_factor/max. BC immersion and dust contact/deposition stay CNT.
+Default: .false.
+</entry>
+
+<entry id="limfacdu_niemand_factor" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+Correction factor multiplying the Niemand frozen fraction FF(T,r) before the
+limfacdu_niemand_max cap is applied (limiter = MIN(factor*FF, max/100)).
+Default: 1.0
+</entry>
+
+<entry id="limfacdu_niemand_max" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+Overall cap on the Niemand frozen fraction of the dust when
+limfacdu_niemand_singular or limfacdu_niemand_continuous is true [percent].
+Default: 100.0 (no cap)
+</entry>
+
+<entry id="depr_point_frz" type="logical" category="conv"
+       group="micro_dv_nl" valid_values="" >
+Enable freezing point depression effect in heterogeneous freezing nucleation
+Default: .true.
+</entry>
+
+<entry id="hclas_du_imm" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for het nuc
+Default: 1
+</entry>
+
+<entry id="hclas_du_dep" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for het nuc
+Default: 1
+</entry>
+
+<entry id="hclas_du_cnt" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for het nuc
+Default: 1
+</entry>
+
+<entry id="hclas_bc_imm" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for het nuc
+Default: 1
+</entry>
+
+<entry id="hclas_bc_dep" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for het nuc
+Default: 1
+</entry>
+
+<entry id="hclas_bc_cnt" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for het nuc
+Default: 1
+</entry>
+
+<entry id="onoff_contact_freezing" type="logical" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+controls contact freezing in pumas/micro_pumas_utils.F90
+Default: true
+</entry>
+
+<entry id="onoff_sip" type="logical" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+controls hallet mossop in pumas/micro_pumas_utils.F90
+Default: true
+</entry>
+
+<entry id="factor_HM" type="real" category="microphys"
+    group="micro_dv_nl" valid_values="" >
+    factor for changing homogeneous nucleation
+    Default: 1
+</entry>
+
+<entry id="rain_freeze" type="logical" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+controls freezing of rain in pumas
+Default: true
+</entry>
+
+<entry id="detrainment_ramp_liq" type="logical" category="conv"
+       group="micro_dv_nl" valid_values="" >
+Turn all detrainment (CLUBB and macroP) to liquid instead of 30dg ramp.
+Default: .false.
+</entry>
+
+<entry id="micro_mg_ice_berg_ice_factor" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for bergeron ice process
+Default: 1
+</entry>
+
+<entry id="micro_mg_ice_berg_snow_factor" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+factor for bergeron snow process
+Default: 1
+</entry>
+
+<entry id="auto_liq_factor" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+Multiplier applied to liquid autoconversion rate (prc, nprc, nprc1) for sensitivity tuning.
+Applies to both KK2000 and SB2001v2 schemes.
+Default: 1.0
+</entry>
+
+<entry id="riming_factor" type="real" category="microphys"
+       group="micro_dv_nl" valid_values="" >
+Multiplier applied to snow riming rate (psacws, npsacws) for sensitivity tuning.
+Scaling occurs before the Hallett-Mossop secondary ice call, so H-M splinter
+production is also proportionally affected.
+Default: 1.0
+</entry>
+
 </namelist_definition>
